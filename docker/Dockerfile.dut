# Dockerfile for isolated DUT execution
# This provides a sandboxed environment for running Device Under Test (DUT) code

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

# Set labels for tracking
LABEL app="brownbench"
LABEL component="dut-executor"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash dutuser

# Set working directory
WORKDIR /workspace

# Copy requirements (if provided during build)
# This can be overridden at build time
COPY requirements.txt /tmp/requirements.txt 2>/dev/null || echo "anthropic" > /tmp/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Switch to non-root user
USER dutuser

# Default command (can be overridden)
CMD ["/bin/bash"]
